  "review": {
    "background": "#8E9496",
    "ground": "#5E605C",
    "fog": {
      "color": "#8E9496",
      "start": 25,
      "end": 140
    },
    "exposure": 1.0,
    "hdri": null,
    "mannequin_height": 1.75,
    "views": [
      "front",
      "three_quarter",
      "eye",
      "iso",
      "feed",
